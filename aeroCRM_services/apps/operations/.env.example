MODE=development
APP_REVISION=local
OPERATIONS_PROCESS_ROLE=api
OPERATIONS_API_PORT=5200
OPERATIONS_WORKER_PORT=5201
OPERATIONS_OUTBOX_PUBLISHER_PORT=5202
OPERATIONS_LISTEN_HOST=127.0.0.1
OPERATIONS_DATABASE_URL=postgresql://aerocrm_operations_runtime:change_me@127.0.0.1:55441/aerocrm_operations?schema=operations&sslmode=disable
OPERATIONS_MIGRATION_DATABASE_URL=postgresql://aerocrm_operations_migration:change_me@127.0.0.1:55441/aerocrm_operations?schema=operations&sslmode=disable
OPERATIONS_BACKUP_URL=postgresql://aerocrm_operations_backup:change_me@127.0.0.1:5432/aerocrm_operations?schema=operations&sslmode=disable
DATABASE_BACKUP_PROVENANCE_KEY_ID=operations-backup-ed25519-2026-08-31
DATABASE_BACKUP_PROVENANCE_PRIVATE_KEY_FILE=/run/aerocrm-operations-secrets/database-backup-provenance-private-key.pem
OPERATIONS_OUTBOX_BATCH_SIZE=50
OPERATIONS_OUTBOX_POLL_INTERVAL_MS=1000
OPERATIONS_AUDIT_RECEIPT_LEASE_MS=60000
OPERATIONS_AUDIT_RETRY_DELAY_MS=30000
OPERATIONS_AUDIT_MAX_RETRY_ATTEMPTS=4

# Private service federation. Every URL must be an exact HTTP origin.
NOTIFICATION_DELIVERY_INTERNAL_URL=http://127.0.0.1:4401
NOTIFICATION_DELIVERY_OPERATIONS_TOKEN=change_me_notification_delivery_operations_token_32_chars
CAMPAIGNS_INTERNAL_BASE_URL=http://127.0.0.1:4500
CAMPAIGNS_OPERATIONS_TOKEN=change_me_campaigns_operations_token_at_least_32_chars
REPORTING_INTERNAL_BASE_URL=http://127.0.0.1:4600
REPORTING_OPERATIONS_TOKEN=change_me_reporting_operations_token_at_least_32_chars
BILLING_INTERNAL_BASE_URL=http://127.0.0.1:4800
BILLING_OPERATIONS_TOKEN=change_me_billing_operations_token_at_least_32_chars
IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_INTERNAL_TIMEOUT_MS=10000
IDENTITY_OPERATIONS_TOKEN=change_me_identity_operations_token_at_least_32_chars
PLATFORM_INTERNAL_BASE_URL=http://127.0.0.1:5000
PLATFORM_OPERATIONS_TOKEN=change_me_platform_operations_token_at_least_32_chars
SUPPORT_INTERNAL_BASE_URL=http://127.0.0.1:5100
SUPPORT_OPERATIONS_TOKEN=change_me_support_operations_token_at_least_32_chars

# Inbound private contracts.
OPERATIONS_IDENTITY_TOKEN=change_me_operations_identity_token_at_least_32_chars
REPORTING_INTERNAL_TOKEN=change_me_reporting_internal_token_at_least_32_chars

CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback
RABBITMQ_URL=amqp://aerocrm-operations:change_me@127.0.0.1:5672/aerocrm
# worker: aerocrm-operations-worker; restore-worker: aerocrm-operations-restore-worker; outbox-publisher: aerocrm-operations-outbox-publisher
RABBITMQ_CONNECTION_NAME=aerocrm-operations-worker
# worker/restore-worker: true; outbox-publisher: false
RABBITMQ_ASSERT_TOPOLOGY=true
RABBITMQ_MAX_MESSAGE_BYTES=262144
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
RABBITMQ_VHOST=aerocrm
RABBITMQ_MONITOR_USER=aerocrm-monitor
RABBITMQ_MONITOR_PASSWORD=change_me

# Telegram transport. Production accepts only the established TLS proxy URL.
TELEGRAM_INFO_BOT_CONFIGURED=true
TELEGRAM_INFO_BOT_USERNAME=aerocrm_info_bot

# Read-only backup-role URLs used only by operations-worker/pg_dump.
NOTIFICATION_DELIVERY_BACKUP_URL=postgresql://aerocrm_notification_delivery_backup:change_me@127.0.0.1:5432/aerocrm_notification_delivery?schema=notification_delivery&sslmode=disable
CAMPAIGNS_BACKUP_URL=postgresql://aerocrm_campaigns_backup:change_me@127.0.0.1:5432/aerocrm_campaigns?schema=campaigns&sslmode=disable
REPORTING_BACKUP_URL=postgresql://aerocrm_reporting_backup:change_me@127.0.0.1:5432/aerocrm_reporting?schema=reporting&sslmode=disable
BILLING_BACKUP_URL=postgresql://aerocrm_billing_backup:change_me@127.0.0.1:5432/aerocrm_billing?schema=billing&sslmode=disable
IDENTITY_BACKUP_URL=postgresql://aerocrm_identity_backup:change_me@127.0.0.1:5432/aerocrm_identity?schema=identity&sslmode=disable
PLATFORM_BACKUP_URL=postgresql://aerocrm_platform_backup:change_me@127.0.0.1:5432/aerocrm_platform?schema=platform&sslmode=disable
SUPPORT_BACKUP_URL=postgresql://aerocrm_support_backup:change_me@127.0.0.1:5432/aerocrm_support?schema=support&sslmode=disable
CRM_ACCESS_BACKUP_URL=postgresql://aerocrm_crm_access_backup:change_me@127.0.0.1:5432/aerocrm_crm_access?schema=crm_access&sslmode=disable
CRM_INTAKE_BACKUP_URL=postgresql://aerocrm_crm_intake_backup:change_me@127.0.0.1:5432/aerocrm_crm_intake?schema=crm_intake&sslmode=disable
CRM_CUSTOMERS_BACKUP_URL=postgresql://aerocrm_crm_customers_backup:change_me@127.0.0.1:5432/aerocrm_crm_customers?schema=crm_customers&sslmode=disable
CRM_SALES_BACKUP_URL=postgresql://aerocrm_crm_sales_backup:change_me@127.0.0.1:5432/aerocrm_crm_sales?schema=crm_sales&sslmode=disable

# Restore routes and worker are disabled for the S3-only first release.
DATABASE_RESTORE_ENABLED=false

CRM_BACKUP_S3_ENDPOINT=https://s3.example.invalid
CRM_BACKUP_S3_REGION=ru-1
CRM_BACKUP_S3_BUCKET=change_me_private_bucket
CRM_BACKUP_S3_FORCE_PATH_STYLE=true
CRM_BACKUP_S3_ACCESS_KEY_ID=change_me
CRM_BACKUP_S3_SECRET_ACCESS_KEY=change_me
CRM_BACKUP_RETENTION_DAYS=7
CRM_BACKUP_BUCKET_CONSOLE_URL=https://console.example.invalid/private-bucket
