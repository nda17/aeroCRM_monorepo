MODE=development
APP_REVISION=local

NOTIFICATION_DELIVERY_LISTEN_HOST=127.0.0.1
NOTIFICATION_DELIVERY_HEALTH_PORT=4401
NOTIFICATION_DELIVERY_DATABASE_URL=postgresql://aerocrm_notification_delivery_runtime:change_me@127.0.0.1:5432/aerocrm_notification_delivery?schema=notification_delivery&sslmode=disable
NOTIFICATION_DELIVERY_MIGRATION_URL_PRODUCTION=postgresql://aerocrm_notification_delivery_migration:change_me@127.0.0.1:5432/aerocrm_notification_delivery?schema=notification_delivery&sslmode=disable
NOTIFICATION_DELIVERY_KINDS=campaign-email,campaign-telegram,daily-summary-delivery-telegram,operations-backup-report-telegram,subscription-expiry-email,subscription-expiry-telegram,support-team-email,support-team-telegram,support-client-email,wincrm-invitation-email,wincrm-task-reminder-email,wincrm-task-reminder-telegram,wincrm-intake-sla-email,wincrm-intake-sla-telegram
NOTIFICATION_DELIVERY_PREFETCH=5
NOTIFICATION_DELIVERY_OUTBOX_BATCH_SIZE=50
NOTIFICATION_DELIVERY_OUTBOX_POLL_INTERVAL_MS=1000
NOTIFICATION_DELIVERY_OUTBOX_RETENTION_DAYS=7
NOTIFICATION_DELIVERY_RECEIPT_RETENTION_DAYS=90
NOTIFICATION_DELIVERY_FAILURE_DETAIL_RETENTION_DAYS=30

# after the new topology/ACLs, migration and Identity invitation feature are ready.
# These scoped credentials are unused by the default consumer set.
IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_NOTIFICATION_DELIVERY_TOKEN=change_me

# Operations -> Notification Delivery control API.
NOTIFICATION_DELIVERY_OPERATIONS_TOKEN=change_me

RABBITMQ_URL=amqp://aerocrm-notification-delivery:change_me@127.0.0.1:5672/aerocrm
RABBITMQ_CONNECTION_NAME=aerocrm-notification-delivery
RABBITMQ_ASSERT_TOPOLOGY=true
RABBITMQ_MAX_MESSAGE_BYTES=262144

SMTP_SERVER=127.0.0.1
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_LOGIN=change_me
SMTP_FROM="aeroCRM" <info@aerocrm.space>
SMTP_PASSWORD=change_me
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=15000
# Historical shared name: Notification Delivery uses this only as the public
# site base URL for links in email templates, not for reCAPTCHA verification.

TELEGRAM_INFO_BOT_TOKEN=change_me
TELEGRAM_API_BASE_URL=https://telegram.aerocrm.space/telegram-api
TELEGRAM_API_PROXY_IP=185.184.122.62

# Opt-in Intake SLA: append BOTH wincrm-intake-sla-email,wincrm-intake-sla-telegram
# to the existing kinds only after scoped topology/ACLs and the new reader are ready.
# Defaults and the old task-reminder kinds are unchanged. Unique pairwise tokens, not Sales keys.
CRM_INTAKE_INTERNAL_BASE_URL=http://127.0.0.1:5310
CRM_INTAKE_NOTIFICATION_DELIVERY_TOKEN=change_me
NOTIFICATION_DELIVERY_CRM_INTAKE_TOKEN=change_me

# CRM support chat delivery is opt-in through NOTIFICATION_DELIVERY_KINDS.
# Add support-team-email,support-team-telegram,support-client-email after compatible Support/ACL deployment.
SUPPORT_INTERNAL_BASE_URL=http://127.0.0.1:5100
SUPPORT_NOTIFICATION_DELIVERY_TOKEN=
# Outbound-only: use the existing Support bot, never the INFO bot. No webhook is configured here.
TELEGRAM_SUPPORT_BOT_TOKEN=
