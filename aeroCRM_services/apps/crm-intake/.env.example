NODE_ENV=development
MODE=development
APP_REVISION=local

CRM_INTAKE_LISTEN_HOST=127.0.0.1
CRM_INTAKE_PORT=5310
CRM_INTAKE_DATABASE_URL=postgresql://aerocrm_crm_intake_runtime:change_me@127.0.0.1:55443/aerocrm_crm_intake?schema=crm_intake&sslmode=disable
CRM_INTAKE_MIGRATION_DATABASE_URL=postgresql://aerocrm_crm_intake_migration:change_me@127.0.0.1:55443/aerocrm_crm_intake?schema=crm_intake&sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Required pairwise authorization with crm-access; use HTTPS for another VPS.
CRM_ACCESS_INTERNAL_BASE_URL=http://127.0.0.1:5300
CRM_ACCESS_CRM_INTAKE_TOKEN=change_me_at_least_32_random_characters
CRM_ACCESS_INTERNAL_TIMEOUT_MS=10000
# Independent roles: api (5310), acceptance worker (5311), publisher (5312), all (5310, local checks).
CRM_INTAKE_PROCESS_ROLE=api
CRM_CUSTOMERS_INTERNAL_BASE_URL=http://127.0.0.1:5320
CRM_CUSTOMERS_CRM_INTAKE_TOKEN=change_me
CRM_SALES_INTERNAL_BASE_URL=http://127.0.0.1:5330
CRM_SALES_CRM_INTAKE_TOKEN=change_me
# Required only by background roles/all; use amqps and a scoped broker principal outside loopback.
CRM_INTAKE_RABBITMQ_URL=amqp://change_me:change_me@127.0.0.1:5672/crm_intake
# Production topology and ACLs are provisioned separately. Enable only for scoped local provisioning.
CRM_INTAKE_RABBITMQ_ASSERT_TOPOLOGY=false

# Intake first-response SLA; reader/DB/grants/scoped topology must be ready before enabling.
# Additional roles of the SAME image: sla-worker (5317, pool 2), sla-publisher (5318, pool 1).
CRM_INTAKE_SLA_ENABLED=false
CRM_INTAKE_SLA_RABBITMQ_URL=amqp://change_me:change_me@127.0.0.1:5672/aerocrm
CRM_INTAKE_SLA_RABBITMQ_ASSERT_TOPOLOGY=false
NOTIFICATION_DELIVERY_INTERNAL_BASE_URL=http://127.0.0.1:4401
# Distinct pairwise secrets, also configured at Notification Delivery; never alias Sales credentials.
CRM_INTAKE_NOTIFICATION_DELIVERY_TOKEN=change_me
NOTIFICATION_DELIVERY_CRM_INTAKE_TOKEN=change_me
