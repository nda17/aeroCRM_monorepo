MODE=development
APP_REVISION=local

BILLING_PROCESS_ROLE=api
BILLING_API_PORT=4800
BILLING_SCHEDULER_PORT=4801
BILLING_WORKER_PORT=4802
BILLING_OUTBOX_PUBLISHER_PORT=4803
BILLING_LISTEN_HOST=127.0.0.1
BILLING_DATABASE_URL=postgresql://aerocrm_billing_runtime:change_me@127.0.0.1:55437/aerocrm_billing?schema=billing&sslmode=disable
BILLING_MIGRATION_DATABASE_URL=postgresql://aerocrm_billing_migration:change_me@127.0.0.1:55437/aerocrm_billing?schema=billing&sslmode=disable

CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback

# Inbound service credentials. Use distinct random values in production.
BILLING_IDENTITY_TOKEN=change_me
BILLING_CRM_ACCESS_TOKEN=change_me
CRM_ACCESS_INTERNAL_BASE_URL=http://127.0.0.1:5300
# CRM commerce uses explicit payment launch and reconciliation gates.
BILLING_CRM_PAYMENTS_ENABLED=false
# Retain for worker/scheduler drain after sales close; no broker secret in scheduler.
BILLING_CRM_RECONCILIATION_ENABLED=false
CRM_FRONTEND_ORIGIN=https://workspace.aerocrm.space
# Separate reverse credential: Billing worker -> CRM Access payment authority.
BILLING_CRM_ACCESS_COMMERCE_BASE_URL=
BILLING_CRM_ACCESS_COMMERCE_TOKEN=change_me
# Own least-privilege consumer credentials; production must use AMQPS.
BILLING_CRM_PROVIDER_RABBITMQ_URL=
BILLING_CRM_PROVIDER_ASSERT_TOPOLOGY=false
BILLING_CAMPAIGNS_TOKEN=change_me
BILLING_OPERATIONS_TOKEN=change_me
# Outbound private HTTP dependencies.
IDENTITY_INTERNAL_BASE_URL=http://127.0.0.1:4900
IDENTITY_INTERNAL_TIMEOUT_MS=10000
IDENTITY_BILLING_TOKEN=change_me

PAYMENT_METHOD_ENCRYPTION_KEY=change_me
YOOKASSA_TEST_SHOP_ID=change_me
YOOKASSA_TEST_SECRET_KEY=change_me
YOOKASSA_PRODUCTION_SHOP_ID=
YOOKASSA_PRODUCTION_SECRET_KEY=
CRM_PAYMENT_LAUNCH_MODE=test

# Inputs for the one-shot CRM policy bootstrap, not application runtime.
CRM_MONTHLY_PRICE_RUB=989
CRM_YEARLY_PRICE_RUB=
CRM_ADDITIONAL_SEAT_MONTHLY_PRICE_RUB=289
CRM_ADDITIONAL_SEAT_YEARLY_PRICE_RUB=3468
CRM_TRIAL_DAYS=10
CRM_TRIAL_SEAT_LIMIT=3
CRM_INCLUDED_SEATS=3

RABBITMQ_URL=amqp://aerocrm-billing:change_me@127.0.0.1:5672/aerocrm
# Must equal aerocrm-billing-<BILLING_PROCESS_ROLE> for worker/publisher roles.
RABBITMQ_CONNECTION_NAME=aerocrm-billing-api
RABBITMQ_ASSERT_TOPOLOGY=false
RABBITMQ_MAX_MESSAGE_BYTES=262144
BILLING_PREFETCH=10
BILLING_OUTBOX_BATCH_SIZE=50
BILLING_OUTBOX_POLL_INTERVAL_MS=1000
BILLING_OUTBOX_RETENTION_DAYS=7
BILLING_RECEIPT_RETENTION_DAYS=90
BILLING_FAILURE_DETAIL_RETENTION_DAYS=30
