{
	"name": "@aerocrm/crm",
	"version": "0.1.0",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": ">=20.17"
	},
	"packageManager": "pnpm@9.15.9",
	"scripts": {
		"dev": "next dev --port 3001",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run && vitest run --config vitest.turnstile.config.mjs",
		"typecheck": "next typegen && tsc --noEmit",
		"format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,scss}\" \"*.{js,mjs,ts,json,md}\" ",
		"format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,scss}\" \"*.{js,mjs,ts,json,md}\" ",
		"check": "pnpm format:check && pnpm lint && pnpm test && pnpm typecheck && pnpm build"
	},
	"lint-staged": {
		"*.{ts,tsx,js,mjs,json,scss,md,yml}": "pnpm --filter @aerocrm/crm exec prettier --write",
		"*.{ts,tsx}": "pnpm --filter @aerocrm/crm exec eslint --fix --max-warnings=0"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@tanstack/react-query": "5.102.8",
		"axios": "1.20.0",
		"clsx": "2.1.1",
		"libphonenumber-js": "1.12.42",
		"next": "16.3.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.87.0",
		"react-hot-toast": "2.6.0",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@testing-library/react": "16.3.3",
		"@types/node": "20.19.39",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"autoprefixer": "10.5.4",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.3",
		"husky": "9.1.7",
		"jsdom": "26.1.0",
		"lint-staged": "16.4.0",
		"postcss": "8.5.26",
		"prettier": "3.8.2",
		"sass": "1.103.1",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
